<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Immutable audit trail of every claim status transition. Written in-transaction for FinTech auditability.</description>
    <enableActivities>false</enableActivities>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>Claim Status History</label>
    <nameField>
        <displayFormat>CSH-{00000000}</displayFormat>
        <label>History #</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Claim Status Histories</pluralLabel>
    <sharingModel>ControlledByParent</sharingModel>
</CustomObject>
